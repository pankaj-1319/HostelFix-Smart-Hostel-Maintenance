@RELATION hostel_complaints

@ATTRIBUTE Hostel_Block {A,B,C,D}
@ATTRIBUTE Complaint_Type {Water Leakage,Electricity,Wi-Fi,Cleaning,Furniture,Fan/AC,Plumbing}
@ATTRIBUTE Location {Bathroom,Room,Corridor,Common Area,Study Room,Mess}
@ATTRIBUTE Severity {Low,Medium,High,Urgent}
@ATTRIBUTE Season {Summer,Monsoon,Winter}
@ATTRIBUTE Days_Pending NUMERIC
@ATTRIBUTE Previous_Complaints NUMERIC
@ATTRIBUTE Affected_Rooms NUMERIC
@ATTRIBUTE Staff_Available NUMERIC
@ATTRIBUTE Resolution_Time_Days NUMERIC
@ATTRIBUTE Priority {Low,Medium,High,Urgent}

